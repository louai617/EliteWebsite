# Frontend (public website + client portal), runs on http://localhost:3001.
# Only PUBLIC values belong here — this app never talks to the database and holds no secrets.

# Backend REST API (CRM backend, port 3002).
NEXT_PUBLIC_API_URL=http://localhost:3002/api
# Staff CRM (same backend). Staff who sign in on the website are sent here.
NEXT_PUBLIC_CRM_URL=http://localhost:3002
# Public site URL (SEO metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# Business time zone for dates shown in the portal.
NEXT_PUBLIC_BUSINESS_TIMEZONE=Asia/Qatar
