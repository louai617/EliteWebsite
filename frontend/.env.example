# ---------------------------------------------------------------------------
# ELITE Real Estate CRM: environment variables
# Copy to `.env.local` for local development. Never commit real values.
# Only variables prefixed with NEXT_PUBLIC_ are ever sent to the browser, so
# nothing below (except NEXT_PUBLIC_SITE_URL) is exposed client-side.
# ---------------------------------------------------------------------------

# MongoDB Atlas connection string (server-side only).
# Atlas → Database → Connect → Drivers → copy the "mongodb+srv://" string.
MONGODB_URI=

# Optional: database name when it is not part of MONGODB_URI (default: elite_crm)
MONGODB_DB=elite_crm

# Secret used to sign session cookies. At least 32 random characters.
# Generate one with:  openssl rand -base64 48
AUTH_SECRET=

# Public site URL (used for metadata, absolute links and CSRF origin checks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Used only by `npm run seed` to create the first admin account.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=ELITE Administrator
