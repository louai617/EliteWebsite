# Frontend (public website + client portal), runs on http://localhost:3001.
# Production: https://eliterealestate.qa. This app never talks to the database: every property,
# booking and saved home lives in the agent app (CRM, port 3002 / https://app.eliterealestate.qa).
# NEXT_PUBLIC_ values are visible in the browser — never put secrets in them.

# Backend REST API (agent app).            Production: https://app.eliterealestate.qa/api
NEXT_PUBLIC_API_URL=http://localhost:3002/api
# Staff CRM. Staff who sign in on the website are sent here.  Production: https://app.eliterealestate.qa
NEXT_PUBLIC_CRM_URL=http://localhost:3002
# Public site URL (SEO metadata).          Production: https://eliterealestate.qa
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# ─── Server-only (never sent to the browser) ───
# Optional: URL the website's server uses to fetch listings, e.g. an internal network address
# when both apps run on the same host. Defaults to NEXT_PUBLIC_API_URL.
# API_INTERNAL_URL=http://127.0.0.1:3002/api
# Shared secret the agent app uses to refresh listings instantly. Must equal
# WEBSITE_REVALIDATE_SECRET in backend/.env. Generate: openssl rand -base64 32
REVALIDATE_SECRET=
# Business time zone for dates shown in the portal.
NEXT_PUBLIC_BUSINESS_TIMEZONE=Asia/Qatar
