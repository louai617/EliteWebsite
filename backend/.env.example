# ─── Agent app / CRM backend (port 3002) — server-side only, never exposed to the browser ───
# Production: https://app.eliterealestate.qa (agents) — the website is https://eliterealestate.qa.
# See SETUP.md → "Two portals and domains" for the full production values.

# SQLite database file, relative to this folder.
DATABASE_URL="file:./dev.db"

# Key used to HMAC session tokens before they are stored. Required in production.
# Generate one with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"

# Business time zone: daily tasks, daily reports and the midnight rollover use it.
# (NEXT_PUBLIC_ because the same value formats dates in the browser — it is not a secret.)
NEXT_PUBLIC_BUSINESS_TIMEZONE="Asia/Qatar"

# Public origin of this app. Used for absolute photo URLs in the public listings API.
# Production: APP_URL="https://app.eliterealestate.qa"
APP_URL="http://localhost:3002"

# ─── Website / client portal (frontend, port 3001) ───
# Origin of the website; also the default CORS allow-list and where client accounts are sent.
# Production: CLIENT_APP_URL="https://eliterealestate.qa"
CLIENT_APP_URL="http://localhost:3001"
# Comma-separated origins allowed to call /api with cookies (defaults to CLIENT_APP_URL).
# Production: CORS_ORIGINS="https://eliterealestate.qa,https://www.eliterealestate.qa"
# CORS_ORIGINS="http://localhost:3001"
# Where CLIENT accounts are redirected if they open the CRM (defaults to CLIENT_APP_URL/en/dashboard).
# CLIENT_PORTAL_URL="http://localhost:3001/en/dashboard"

# Session cookie. Leave unset for localhost (both apps share the "localhost" cookie).
# eliterealestate.qa and app.eliterealestate.qa are the same site, so "lax" works; share the
# cookie across both with the parent domain.
# Production: SESSION_COOKIE_DOMAIN=".eliterealestate.qa"
# SESSION_COOKIE_SAMESITE="lax"
# SESSION_COOKIE_DOMAIN=""

# ─── Live website sync ───
# Whenever a property is created/edited/published/sold here, the website is told to refresh its
# listings immediately (otherwise it refreshes on its own within 60 s).
# Must equal REVALIDATE_SECRET in the website's .env.local. Generate: openssl rand -base64 32
# Leave empty to disable instant sync.
WEBSITE_REVALIDATE_SECRET=""
# Defaults to CLIENT_APP_URL + /api/revalidate.
# WEBSITE_REVALIDATE_URL="http://localhost:3001/api/revalidate"

# ─── Daily rollover (closing each business day) ───
# The web server checks every minute and closes the day once after midnight (idempotent).
# Set to "false" when you run it from a system cron instead (npm run cron:daily or the endpoint).
SCHEDULER_ENABLED="true"
# Bearer secret for POST /api/cron/daily-rollover (external cron). Leave empty to disable the endpoint.
CRON_SECRET=""

# ─── Listing imports ───
# Property Finder: a JSON listing export/feed URL your agency has access to (optional) and,
# if that endpoint needs it, an API key (sent as "Authorization: Bearer <key>").
PROPERTY_FINDER_FEED_URL=""
PROPERTY_FINDER_API_KEY=""
# Qatar Living: same, for a JSON export/feed you are entitled to.
QATAR_LIVING_FEED_URL=""
QATAR_LIVING_API_KEY=""
# Max records per import run.
IMPORT_MAX_RECORDS="2000"
